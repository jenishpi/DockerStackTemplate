    @stirling-pdf host stirling-pdf.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @stirling-pdf {
        reverse_proxy {env.DUCKDNS_IP}:8082
    }

    @bentopdf host bentopdf.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @bentopdf {
        reverse_proxy {env.DUCKDNS_IP}:8083
    }

    @convertx host convertx.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @convertx {
        reverse_proxy {env.DUCKDNS_IP}:8084
