{    
    email {env.DUCKDNS_EMAIL}
}

*.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }    

    # --- Databases & DB Management ---
    @dynamodb host dynamodb.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @dynamodb {
        reverse_proxy {env.DUCKDNS_IP}:8000
    }

    @dynamodb-admin host dynamodb-admin.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @dynamodb-admin {
        reverse_proxy {env.DUCKDNS_IP}:8001
    }

    @redisinsight host redisinsight.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @redisinsight {
        reverse_proxy {env.DUCKDNS_IP}:8002
    }

    @redis host redis.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @redis {
        reverse_proxy {env.DUCKDNS_IP}:6379
    }

    @mongoclient host mongoclient.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org dwc-artist.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @mongoclient {
        reverse_proxy {env.DUCKDNS_IP}:8003
    }

    @mongodb host mongodb.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @mongodb {
        reverse_proxy {env.DUCKDNS_IP}:27017
    }

    @postgres host postgres.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @postgres {
        reverse_proxy {env.DUCKDNS_IP}:5432
    }

    @pgadmin host pgadmin.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org postgresweb.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org postgesweb.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @pgadmin {
        reverse_proxy {env.DUCKDNS_IP}:8087
    }

    @adminer host adminer.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @adminer {
        reverse_proxy {env.DUCKDNS_IP}:8088
    }

    @sqlserver host sqlserver.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @sqlserver {
        reverse_proxy {env.DUCKDNS_IP}:1433
    }

    # --- Developer IT-Tools ---
    @it-tools host it-tools.{env.DUCKDNS_SUBDOMAINNAME}.duckdns.org
    handle @it-tools {
